# Copy this file to .env and fill in real values. .env is gitignored.

PORT=3200

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# https://www.themoviedb.org/settings/api (use the v3 auth "API Key")
TMDB_API_KEY=

# RapidAPI "OTT Details" API (host: ott-details.p.rapidapi.com)
RAPIDAPI_KEY=
RAPIDAPI_HOST=ott-details.p.rapidapi.com

# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
